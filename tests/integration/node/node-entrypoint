#!/bin/bash
# Entry point of the integration test containers.
#   ROLE=router  plain IPv4 router between all underlay networks
#   ROLE=nat     a NAT router: masquerades its LAN behind its WAN address
#   ROLE=site    a wanderlan site: underlay + trunk interface (renamed trunk0)
#   ROLE=client  a host on the trunk of a site (VLAN subinterfaces added by tests)
set -euo pipefail

# Prints the interface that has an IPv4 address starting with the prefix.
find_if() {
  ip -o -4 addr show | awk -v p="$1" 'index($4, p) == 1 { print $2; exit }'
}

# Renames the interface on the given network to trunk0 and removes its
# address.
make_trunk() {
  local dev
  dev=$(find_if "$1")
  if [ -z "$dev" ]; then
    echo "no interface on $1" >&2
    exit 1
  fi
  ip addr flush dev "$dev"
  ip link set "$dev" down
  ip link set "$dev" name trunk0
  ip link set trunk0 up
}

case "${ROLE:-site}" in
  router)
    # "The internet" of the local breakout.
    ip link add inet0 type dummy
    ip link set inet0 up
    ip addr add 203.0.113.1/32 dev inet0
    ip -6 addr add 2001:db8:ffff::1/128 dev inet0 2>/dev/null || true
    ;;
  nat)
    wan=$(find_if "$WAN_NET")
    ip route replace default via "$GATEWAY"
    # Random ports: no port is kept, like a NAT under load. A counter of
    # the flows that come in from outside to this box (the servers must open
    # none; multicast of the host, e.g. mDNS, does not count). The test
    # frames of the server to the tunnel port are expected: they end here.
    nft -f - <<NFT
table ip nat {
  chain post { type nat hook postrouting priority srcnat; oifname "$wan" masquerade random; }
}
table ip watch {
  chain pre {
    type filter hook prerouting priority 0;
    iifname "$wan" udp dport 51822 ct state new return comment "test frames"
    iifname "$wan" meta pkttype host ct state new counter comment "new from wan"
  }
}
NFT
    ;;
  site)
    make_trunk "$TRUNK_NET"
    if [ -n "${GATEWAY:-}" ]; then
      ip route replace default via "$GATEWAY"
    fi
    if [ -n "${GATEWAY6:-}" ]; then
      ip -6 route replace default via "$GATEWAY6"
    fi
    # A second uplink: a default route of its own, with a higher metric.
    if [ -n "${GATEWAY2:-}" ]; then
      ip route add default via "$GATEWAY2" metric 500
    fi
    # Start the daemon like systemd would, if this site was configured before
    # (e.g. after a container restart).
    if grep -qs '^self' /etc/wanderlan/local.toml; then
      wl-daemon start
    fi
    ;;
  client)
    make_trunk "$TRUNK_NET"
    ;;
  *)
    echo "unknown ROLE ${ROLE}" >&2
    exit 1
    ;;
esac

touch /run/node-ready
exec sleep infinity
