[Unit]
Description=wanderlan layer-2 site connector daemon
Documentation=https://github.com/upchui/Wanderlan
After=network-online.target
Wants=network-online.target
# Never give up restarting: without the daemon the sites are not connected.
StartLimitIntervalSec=0

[Service]
Type=simple
# What an earlier run left behind if its ExecStopPost could not run (some
# kernels also kill a process started into the unit's cgroup after
# `systemctl kill`); usually nothing.
ExecStartPre=-+/usr/bin/wanderland --cleanup
# The kernel modules only while wanderlan runs ("+": with full rights, the
# daemon itself may not load modules; "-": not possible in a container).
ExecStartPre=-+/sbin/modprobe -a bridge vxlan veth sch_ingress cls_flower act_vlan act_gact nf_tables
ExecStart=/usr/bin/wanderland
ExecReload=/bin/kill -HUP $MAINPID
# After every end of the service (stop, restart, update, crash, kill):
# nothing of wanderlan stays. A start builds everything anew.
ExecStopPost=-+/usr/bin/wanderland --cleanup
# Also after a crash or a kill; `systemctl stop` stops it for good.
Restart=always
RestartSec=2s
# Many peers and clients at once: more than the default 1024 descriptors.
LimitNOFILE=8192
TimeoutStopSec=30s

# Runs as root but with CAP_NET_ADMIN and CAP_NET_RAW as its only
# capabilities (CAP_NET_RAW and AF_PACKET: a client behind NAT sends a
# keepalive frame through its tunnel, so that its NAT stays open).
User=root
Group=wanderlan
UMask=0007
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes

RuntimeDirectory=wanderlan
RuntimeDirectoryMode=0750
StateDirectory=wanderlan
StateDirectoryMode=0750
ProtectSystem=strict
# The local breakout turns on forwarding (on its interfaces and uplinks, and
# for IPv6) while it is configured, and puts it back afterwards; the rest of
# /proc/sys stays read-only (ProtectKernelTunables).
ReadWritePaths=/etc/wanderlan /proc/sys/net/ipv4/conf /proc/sys/net/ipv6/conf
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6 AF_PACKET
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
