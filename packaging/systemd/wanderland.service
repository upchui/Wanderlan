[Unit]
Description=wanderlan layer-2 site connector daemon
Documentation=https://github.com/upchui/Wanderlan
After=network-online.target
Wants=network-online.target
# Never give up restarting: without the daemon the sites are not connected.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/wanderland
ExecReload=/bin/kill -HUP $MAINPID
# Also after a crash or a kill; `systemctl stop` stops it for good.
Restart=always
RestartSec=2s
TimeoutStopSec=30s

# Runs as root but with CAP_NET_ADMIN as its only capability.
User=root
Group=wanderlan
UMask=0007
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=yes

RuntimeDirectory=wanderlan
RuntimeDirectoryMode=0750
StateDirectory=wanderlan
StateDirectoryMode=0750
ProtectSystem=strict
ReadWritePaths=/etc/wanderlan
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
